{
  "manifest_version": 3,
  "name": "PickList : Daily Order Pulls for Nifty",
  "short_name": "PickList",
  "version": "1.0.1",
  "description": "Automatically retrieves sold orders from Nifty, sorts descending by numeric SKU, and syncs into Apple Reminders & Google Tasks.",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "identity",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://app.nifty.ai/*",
    "https://api.nifty.ai/*",
    "http://127.0.0.1:8989/*",
    "http://localhost:8989/*",
    "https://tasks.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://*.chromiumapp.org/*",
    "https://*.workers.dev/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.workers.dev/*",
      "https://spencerstarky.github.io/*"
    ]
  },
  "oauth2": {
    "client_id": "231991706388-ronnrq67mcfgg7e39aaj1rp7mop9obgc.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/tasks"
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "PickList",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
